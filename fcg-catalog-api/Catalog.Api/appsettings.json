{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "MassTransit": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=catalog.db"
  },
  "Jwt": {
    "Issuer": "FCG",
    "Audience": "FCG"
  },
  "RabbitMq": {
    "Host": "localhost"
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "fcg_catalog",
    "GameDetailsCollection": "game_details",
    "ReviewsCollection": "game_reviews"
  },
  "Cache": {
    "RedisEnabled": true,
    "RedisConnectionString": "localhost:6379",
    "InstanceName": "fcg:catalog:",
    "GamesListSeconds": 60,
    "GameDetailsSeconds": 300,
    "ReviewsSeconds": 120,
    "SearchSeconds": 90
  },
  "Elasticsearch": {
    "Enabled": true,
    "Url": "http://localhost:9200",
    "IndexName": "fcg-games",
    "TimeoutSeconds": 5,
    "ReindexOnStartupIfEmpty": true
  }
}
