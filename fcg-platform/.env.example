# Copie para .env e preencha antes de subir a stack:  Copy-Item .env.example .env
#
# .env esta no .gitignore — nenhum segredo real deve ser commitado. O compose recusa
# subir se alguma destas variaveis estiver vazia.

# Chave de assinatura do JWT (HS256), minimo de 32 caracteres.
# O mesmo valor e usado pela Users API para assinar, pela Catalog API para validar
# e pelo Kong para conferir a assinatura na borda.
JWT_KEY=

# Senha do administrador criado no start da Users API (admin@fcg.local).
# Precisa ter letra, numero e caractere especial.
SEED_ADMIN_PASSWORD=

# Senha do usuario elastic do Elasticsearch (busca avancada, Fase 4).
ELASTIC_PASSWORD=

# Credenciais do Grafana (http://localhost:3000)
GRAFANA_USER=admin
GRAFANA_PASSWORD=
