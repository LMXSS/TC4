# Copie para .env e ajuste antes de subir a stack:  Copy-Item .env.example .env
#
# .env esta no .gitignore — nenhum segredo real deve ser commitado.

# Chave de assinatura do JWT (HS256), minimo de 32 caracteres.
# O mesmo valor e usado pela Users API para assinar, pela Catalog API para validar
# e pelo Kong para conferir a assinatura na borda. Os tres precisam bater.
JWT_KEY=CHANGE_ME_DEV_KEY_MIN_32_CHARS_LONG!!

# Credenciais do Grafana (http://localhost:3000)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
